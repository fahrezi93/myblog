---
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full max-w-5xl xl:max-w-6xl mx-auto px-6 sm:px-8 py-8 mt-auto border-t border-subtle"
>
  <div
    class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-muted"
  >
    <p>&copy; {currentYear} fahreziblog. Hak cipta dilindungi.</p>
    <div class="flex gap-4">
      <a
        href="https://github.com/fahrezi93"
        target="_blank"
        rel="noopener noreferrer"
        class="hover-text-accent transition-colors">GitHub</a
      >
      <a
        href="https://instagram.com/moh.fahrezi"
        target="_blank"
        rel="noopener noreferrer"
        class="hover-text-accent transition-colors">Instagram</a
      >
    </div>
  </div>
</footer>
