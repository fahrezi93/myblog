---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="font-mono text-sm">
    <h2 class="text-xs uppercase tracking-wider text-muted mb-4 font-semibold">On this page</h2>
    <ul class="space-y-2.5">
      {filteredHeadings.map((heading) => (
        <li class={`${heading.depth === 3 ? 'ml-4' : ''}`}>
          <a 
            href={`#${heading.slug}`} 
            class="text-muted hover:text-[#111111] dark:hover:text-[#FAFAFA] transition-colors line-clamp-2"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
