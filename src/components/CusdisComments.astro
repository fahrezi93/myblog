---
export interface Props {
  title: string;
  url: string;
  id: string;
}

const { title, url, id } = Astro.props;
---

<div>
  <h3 class="text-xl font-medium tracking-tight mb-6">Comments</h3>
  
  <div id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id="d02ad2a1-6483-408a-bddb-c0b524e88238"
    data-page-id={id}
    data-page-url={url}
    data-page-title={title}
  ></div>
  <script is:inline async defer src="https://cusdis.com/js/cusdis.es.js"></script>
</div>
