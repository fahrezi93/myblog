---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }: { data: any }) => {
  return data.draft !== true;
});

const sortedPosts = posts.sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPosts = sortedPosts
  .filter((post: any) => post.data.featured)
  .slice(0, 2);
const recentPosts = sortedPosts
  .filter((post: any) => !post.data.featured)
  .slice(0, 3);
---

<BaseLayout title="fahreziblog - Tips, Tricks & Tech Notes">
  <section class="py-10 mb-12 border-b border-subtle">
    <div class="flex items-center gap-3 mb-4">
      <div class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
      </div>
      <span class="text-sm font-mono text-muted">Available for freelance work</span>
    </div>

    <h1 class="text-4xl font-medium tracking-tight mb-4">
      Halo, saya Fahrezi! 👋
    </h1>

    <p class="text-muted leading-relaxed max-w-xl">
      Saya seorang <em>Fullstack Developer</em> dan <em>Graphic Designer</em>. Di blog ini, saya membagikan catatan pribadi seputar <em>coding</em>, eksplorasi desain, dan tips-tips <em>frontend</em> yang saya pelajari sehari-hari. Singkat, padat, dan semoga bermanfaat buat kamu juga.
    </p>
  </section>

  {
    featuredPosts.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xs uppercase tracking-wider text-muted mb-6 font-semibold font-mono">
          Featured Writing
        </h2>
        <div class="flex flex-col">
          {featuredPosts.map((post: any) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              tags={post.data.tags}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <h2
        class="text-xs uppercase tracking-wider text-muted font-semibold font-mono"
      >
        Recent Tips & Notes
      </h2>
      <a
        href="/blog"
        class="text-xs font-mono hover-text-accent transition-colors text-muted"
        >View all &rarr;</a
      >
    </div>
    <div class="flex flex-col">
      {
        recentPosts.map((post: any) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
