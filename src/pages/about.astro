---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | fahreziblog">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-medium tracking-tight mb-4 text-[#111111] dark:text-[#FAFAFA]">About Me</h1>
    
    <p>
      I'm a frontend engineer focused on building fast, accessible, and minimalist user interfaces. 
      I believe in shipping less JavaScript, respecting user privacy, and creating typography-driven designs.
    </p>

    <h2 class="text-2xl font-medium tracking-tight mt-8 mb-4 text-[#111111] dark:text-[#FAFAFA]">Tech Stack & Tools</h2>
    <ul>
      <li><strong>Framework:</strong> Astro, Next.js, SvelteKit</li>
      <li><strong>Styling:</strong> Tailwind CSS, CSS Modules</li>
      <li><strong>Language:</strong> TypeScript, Rust (Learning)</li>
      <li><strong>Editor:</strong> Neovim / VS Code</li>
    </ul>

    <h2 class="text-2xl font-medium tracking-tight mt-8 mb-4 text-[#111111] dark:text-[#FAFAFA]">Socials</h2>
    <ul>
      <li><a href="https://github.com/fahrezi" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href="https://twitter.com/fahrezi" target="_blank" rel="noopener noreferrer">Twitter</a></li>
      <li><a href="https://linkedin.com/in/fahrezi" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
    </ul>
  </div>
</BaseLayout>
